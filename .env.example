# docker compose 的部署参数（复制为 .env 后填写；.env 已 gitignore）

# 宿主机上的数据目录：语料、引擎索引、任务库、密钥都在这里，容器只挂载不携带
KB_DATA_DIR=/srv/kb-data

# 摄取服务令牌，须与 ${KB_DATA_DIR}/secrets/kb.env 里的 KB_API_TOKEN 完全一致
# 生成：openssl rand -hex 32
KB_API_TOKEN=

# 对外暴露的端口（前面通常还有 Caddy/nginx 做 HTTPS）
KB_WEB_PORT=3456

# CD 拉取的镜像；本地 docker compose build 时留空即可用本地 tag
# KB_IMAGE_WEB=ghcr.io/<owner>/kb-web:latest
# KB_IMAGE_API=ghcr.io/<owner>/kb-api:latest

# 容器运行身份：需与 ${KB_DATA_DIR} 的属主一致，否则容器无法写入数据卷
# 查看：stat -c '%u:%g' ${KB_DATA_DIR}
KB_UID=10001
KB_GID=10001
